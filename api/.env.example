# Clerk PEM public key (Clerk Dashboard > API keys > Show JWT public key > PEM Public Key).
# Used to verify session tokens locally, without calling Clerk.
CLERK_JWT_KEY=
# Comma-separated list of origins allowed by CORS (empty means no browser origin is allowed).
# Locally add the web dev server origin: http://localhost:5173
# The current staging allows https://clavis-via-web.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Milliseconds the mock responder waits before answering, so the "typing" state shows (0 in tests).
MOCK_REPLY_DELAY_MILLISECONDS=900
