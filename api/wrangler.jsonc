{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clavis-via-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "",
    "MOCK_REPLY_DELAY_MILLISECONDS": "900"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://clavis-via-web.vercel.app",
        "MOCK_REPLY_DELAY_MILLISECONDS": "900"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clavis-via-staging",
          "database_id": "b27949b9-cb4d-4418-b9f1-a0488cb45d52",
          "migrations_dir": "migrations"
        }
      ],
      "secrets": {
        "required": ["CLERK_JWT_KEY"]
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 }
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clavis-via",
      "database_id": "388ac391-c183-47a9-b156-4e5f27d3b32f",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["CLERK_JWT_KEY"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
