{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts", "src/i18n/locales/*.json"],
  "exclude": ["src/**/*.test.ts"]
}
