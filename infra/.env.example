# Clerk Backend API secret key (development instance); never commit the real value
CLERK_SECRET_KEY=
# E2E test user; the +clerk_test suffix lets Clerk accept the fixed test code in development
E2E_EMAIL=e2e-main+clerk_test@example.com
# Demo account used in the app presentation (profile name "Ana")
DEMO_EMAIL=ana@example.com
# Password of the demo account
DEMO_PASSWORD=
