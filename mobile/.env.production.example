# Production values for the release APK. Copy to mobile/.env.production (ignored
# by git) and push to EAS with `pnpm --filter @clavis-via/mobile eas:env:push:prod`.

# Public URL of the deployed API (the *.workers.dev address, no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://clavis-via-api.<subdomain>.workers.dev

# Clerk Publishable Key of the instance used by the app (pk_test_... on the development instance).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
