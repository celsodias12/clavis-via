{
  "expo": {
    "name": "CLAVIS VIA",
    "slug": "clavis-via",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clavisvia",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f2fc",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.celsodias.clavisvia",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f2fc",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-localization",
      [
        "expo-dev-client",
        {
          "android": {
            "toolsButton": false,
            "skipOnboarding": true,
            "showMenuAtLaunch": false,
            "defaultLaunchURL": "http://10.0.2.2:8081"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Jost_300Light.ttf",
            "./assets/fonts/Petrona_400Regular.ttf",
            "./assets/fonts/Petrona_500Medium.ttf",
            "./assets/fonts/SourceSans3_400Regular.ttf",
            "./assets/fonts/SourceSans3_500Medium.ttf",
            "./assets/fonts/SourceSans3_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
