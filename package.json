{
  "name": "clavis-via",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "e2e": "pnpm --filter @clavis-via/infra e2e",
    "e2e:web": "pnpm --filter @clavis-via/infra e2e:web",
    "prepare": "if [ -n \"$EAS_BUILD\" ]; then exit 0; fi; git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "react-doctor": "0.9.18"
  },
  "engines": {
    "node": ">=24.22.0",
    "pnpm": ">=11.28.5"
  }
}
